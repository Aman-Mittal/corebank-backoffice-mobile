{
  "name": "corebank-backoffice-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api:preprocess": "mkdir -p api-spec && node scripts/preprocess-spec.mjs spec/openapi.json api-spec/openapi.json",
    "api:generate": "npm run api:preprocess && openapi-typescript api-spec/openapi.json -o src/api/generated/openapi.d.ts",
    "api:check": "node scripts/fetch-spec.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "lint:report": "eslint . -f json -o eslint-report.json || true",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:eslint-rules": "node --test eslint-rules/*.test.js",
    "check:licenses": "node scripts/check-dependency-licenses.mjs",
    "check:licenses:production": "node scripts/check-dependency-licenses.mjs --production",
    "check:licenses:selftest": "node scripts/check-dependency-licenses.mjs --self-test",
    "check:headers": "bash scripts/check-license.sh",
    "check:expected-red": "node scripts/check-expected-red.mjs",
    "check:testids": "node scripts/check-testids.mjs",
    "i18n:check": "node scripts/check-translations.mjs",
    "web:export": "expo export -p web",
    "e2e:web": "playwright test -c e2e/web/playwright.config.ts",
    "e2e:web:mocked": "playwright test -c e2e/web/playwright.config.ts --project=mocked --project=mobile",
    "e2e:native": "maestro test e2e/native/flows --exclude-tags=pending",
    "e2e:stack": "bash scripts/e2e-stack.sh",
    "test:watch": "vitest",
    "docs:tests": "node scripts/gen-unit-catalogue.mjs",
    "check:docs-tests": "node scripts/gen-unit-catalogue.mjs --check",
    "check:test-plan": "node scripts/check-test-plan.mjs",
    "setup": "node scripts/fetch-spec.mjs && npm run api:generate && node scripts/generate-icons.mjs"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "license": "Apache-2.0",
  "description": "CoreBank Backoffice: an independent Expo (iOS/Android/Web) backoffice client compatible with the Apache Fineract REST API. Not an ASF project; see DISCLAIMER.md.",
  "engines": {
    "node": ">=22.22.3"
  }
}
